---
 tv-native/src/core/Atualizador.ts | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/tv-native/src/core/Atualizador.ts b/tv-native/src/core/Atualizador.ts
index 32886932e9c50cdf355292346a3baa62cc75bc10..b159d319d6e527df6a575a9971cb98d4f85c8750 100644
--- a/tv-native/src/core/Atualizador.ts
+++ b/tv-native/src/core/Atualizador.ts
@@ -103,6 +103,7 @@ export class Atualizador {
   private static el: HTMLElement | null = null;
   private static ponteAtiva: any = null; // mantém a chamada viva (o GC cancelaria a assinatura)
   private static instalando = false;
+  private static ponteAutostart: any = null;
 
   static ativo(): boolean {
     return !!URL_VERSAO && Platform.isWebOS;
@@ -110,6 +111,11 @@ export class Atualizador {
 
   static iniciar() {
     if (!this.ativo()) return;
+    // TV com root (webOS 3): depois de um reinício completo (tomada, queda de luz) o sistema não
+    // dispara a inicialização do Homebrew Channel, e ficam desligados o SSH e os ajustes de
+    // /var/lib/webosbrew/init.d (IPv6 desligado, Hearth). Pedimos aqui ao abrir o app; se já
+    // rodou neste boot, o serviço só responde "already executed".
+    try { this.ponteAutostart = chamarLuna('luna://org.webosbrew.hbchannel.service/autostart', {}, () => {}); } catch (e) {}
     window.setTimeout(() => this.verificar(false), 8000);
     window.setInterval(() => this.verificar(false), SEIS_HORAS);
   }
