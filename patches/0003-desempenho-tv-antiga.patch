--- /dev/null
+++ b/tv-native/src/styles/tv-antiga.css
@@ -0,0 +1,13 @@
+/*
+ * Desempenho em TV antiga (LG webOS 3, Chromium 38, sem rolagem acelerada).
+ *
+ * O trilho rola mudando scrollLeft de um contêiner overflow:hidden. No Chromium 38 isso
+ * redesenha pelo processador todas as capas visíveis (342x513 reduzidas a ~248x380) a cada
+ * tecla: ~300 ms por movimento numa LG UJ6525, e as teclas se acumulam.
+ * Com o trilho numa camada própria da GPU, ele é desenhado uma vez e só reposicionado:
+ * ~55 ms por tecla (medido na TV). Nas TVs novas não muda nada visível.
+ */
+.tv-rail-items {
+  -webkit-transform: translateZ(0);
+  transform: translateZ(0);
+}
