index 0000000000000000000000000000000000000000..32886932e9c50cdf355292346a3baa62cc75bc10
--- /dev/null
+++ b/tv-native/src/core/Atualizador.ts
@@ -0,0 +1,246 @@
+/**
+ * Atualização da versão "TV antiga" (LG webOS com root / Homebrew Channel).
+ *
+ * Ao abrir (e a cada 6 h) lê o versao.json publicado pela rotina do repositório privado.
+ * Se houver versão nova, oferece instalar: o pedido vai ao serviço do Homebrew Channel
+ * (`org.webosbrew.hbchannel.service/install`), que baixa o .ipk, confere o SHA-256 e instala.
+ *
+ * Endereço e versão vêm do build (variáveis SAIMO_LG_ATUALIZACAO e SAIMO_LG_VERSAO).
+ * Sem endereço, o módulo não faz nada (build oficial / outras TVs).
+ */
+
+import { Platform } from './Platform';
+import { SpatialNav } from './SpatialNav';
+
+declare const __SAIMO_LG_ATUALIZACAO__: string;
+declare const __SAIMO_LG_VERSAO__: string;
+
+const URL_VERSAO = typeof __SAIMO_LG_ATUALIZACAO__ === 'string' ? __SAIMO_LG_ATUALIZACAO__ : '';
+export const VERSAO_INSTALADA = typeof __SAIMO_LG_VERSAO__ === 'string' ? __SAIMO_LG_VERSAO__ : '';
+
+const SEIS_HORAS = 6 * 60 * 60 * 1000;
+const ADIADA_KEY = 'saimo_lg_atualizacao_adiada';
+
+export interface InfoVersao {
+  versao: string;        // "3.0.601" (formato do webOS, comparável)
+  exibir: string;        // "3.0.6" ou "3.0.6 (revisão 1)"
+  ipkUrl: string;
+  sha256: string;
+  notas?: string;
+}
+
+/** "3.0.5" → "3.0.5"; "3.0.601" → "3.0.6 (revisão 1)". */
+export function versaoLegivel(v: string): string {
+  const p = (v || '').split('.');
+  if (p.length !== 3) return v;
+  const z = parseInt(p[2], 10);
+  if (z < 100) return v;
+  const rev = z % 100;
+  return p[0] + '.' + p[1] + '.' + Math.floor(z / 100) + (rev ? ' (revisão ' + rev + ')' : '');
+}
+
+function comparar(a: string, b: string): number {
+  const pa = a.split('.'), pb = b.split('.');
+  for (let i = 0; i < 3; i++) {
+    const d = (parseInt(pa[i], 10) || 0) - (parseInt(pb[i], 10) || 0);
+    if (d) return d;
+  }
+  return 0;
+}
+
+/** Chamada a um serviço do sistema (webOS) com respostas sucessivas (subscribe). */
+function chamarLuna(uri: string, params: any, aoResponder: (r: any) => void): any {
+  const Bridge = (window as any).PalmServiceBridge;
+  if (!Bridge) throw new Error('Esta TV não permite instalar pelo app');
+  const bridge = new Bridge();
+  bridge.onservicecallback = (msg: string) => {
+    let r: any;
+    try { r = JSON.parse(msg); } catch (e) { r = { returnValue: false, errorText: String(msg) }; }
+    aoResponder(r);
+  };
+  bridge.call(uri, JSON.stringify(params));
+  return bridge;
+}
+
+/**
+ * O instalador do sistema fecha o app no fim. Antes de instalar, deixamos (via `exec` do
+ * Homebrew Channel, que roda como root) um vigia: quando o app fechar, ele o abre de novo,
+ * tentando a cada 2 s porque logo após fechar o webOS ainda recusa abrir. Desiste em 3 min.
+ * O script vai em base64 para não depender de aspas escapadas em várias camadas.
+ */
+const ID_APP = 'br.com.saimo.tv';
+const VIGIA = [
+  'i=0',
+  'while [ $i -lt 180 ]; do',
+  '  sleep 1; i=$((i+1))',
+  "  if ! luna-send -n 1 luna://com.webos.applicationManager/running '{}' | grep -q " + ID_APP + '; then',
+  '    n=0',
+  '    while [ $n -lt 15 ]; do',
+  '      sleep 2; n=$((n+1))',
+  "      r=$(luna-send -n 1 luna://com.webos.applicationManager/launch '{\"id\":\"" + ID_APP + "\"}')",
+  "      case \"$r\" in *'\"returnValue\":true'*) exit 0;; esac",
+  '    done',
+  '    exit 1',
+  '  fi',
+  'done',
+].join('\n') + '\n';
+
+function exec(comando: string) {
+  try {
+    chamarLuna('luna://org.webosbrew.hbchannel.service/exec', { command: comando }, () => {});
+  } catch (e) {}
+}
+
+function armarReabertura() {
+  exec('echo ' + btoa(VIGIA) + ' | base64 -d > /tmp/saimo-reabrir.sh && (nohup sh /tmp/saimo-reabrir.sh >/dev/null 2>&1 &)');
+}
+
+function desarmarReabertura() {
+  exec('pkill -f saimo-reabrir.sh; rm -f /tmp/saimo-reabrir.sh');
+}
+
+export class Atualizador {
+  private static el: HTMLElement | null = null;
+  private static ponteAtiva: any = null; // mantém a chamada viva (o GC cancelaria a assinatura)
+  private static instalando = false;
+
+  static ativo(): boolean {
+    return !!URL_VERSAO && Platform.isWebOS;
+  }
+
+  static iniciar() {
+    if (!this.ativo()) return;
+    window.setTimeout(() => this.verificar(false), 8000);
+    window.setInterval(() => this.verificar(false), SEIS_HORAS);
+  }
+
+  /** manual = pedido em Ajustes: sempre responde (inclusive "já está atualizado"). */
+  static async verificar(manual: boolean): Promise<void> {
+    if (!this.ativo()) {
+      if (manual) this.mostrar('Atualizações', 'A atualização automática não está disponível nesta versão.', [{ rotulo: 'OK' }]);
+      return;
+    }
+    if (this.instalando) return;
+    let info: InfoVersao;
+    try {
+      const res = await fetch(URL_VERSAO + (URL_VERSAO.indexOf('?') >= 0 ? '&' : '?') + 't=' + Date.now());
+      if (!res.ok) throw new Error('HTTP ' + res.status);
+      info = await res.json();
+    } catch (e: any) {
+      console.warn('[Atualizador] Falha ao verificar:', e);
+      if (manual) this.mostrar('Atualizações', 'Não consegui verificar agora. Confira a internet da TV.', [{ rotulo: 'OK' }]);
+      return;
+    }
+    if (!info || !info.versao || comparar(info.versao, VERSAO_INSTALADA) <= 0) {
+      if (manual) this.mostrar('Atualizações', 'Você já está na versão mais recente (' + versaoLegivel(VERSAO_INSTALADA) + ').', [{ rotulo: 'OK' }]);
+      return;
+    }
+    if (!manual) {
+      try { if (localStorage.getItem(ADIADA_KEY) === info.versao) return; } catch (e) {}
+    }
+    const exibir = info.exibir || versaoLegivel(info.versao);
+    this.mostrar(
+      'Atualização disponível',
+      'A versão ' + exibir + ' do Saimo TV está pronta (você está na ' + versaoLegivel(VERSAO_INSTALADA) + ').' +
+        (info.notas ? '\n\nNovidades: ' + info.notas : ''),
+      [
+        { rotulo: 'Instalar agora', primario: true, acao: () => this.instalar(info) },
+        { rotulo: 'Depois', acao: () => { try { localStorage.setItem(ADIADA_KEY, info.versao); } catch (e) {} } },
+      ],
+    );
+  }
+
+  private static instalar(info: InfoVersao) {
+    this.instalando = true;
+    this.mostrar('Instalando atualização', 'Baixando…', []);
+    const texto = (t: string) => {
+      const p = this.el && this.el.querySelector('.saimo-atu-texto');
+      if (p) p.textContent = t;
+    };
+    try {
+      armarReabertura();
+      this.ponteAtiva = chamarLuna(
+        'luna://org.webosbrew.hbchannel.service/install',
+        { id: 'br.com.saimo.tv', ipkUrl: info.ipkUrl, ipkHash: info.sha256, subscribe: true },
+        (r) => {
+          if (r.returnValue === false || r.errorText) {
+            desarmarReabertura();
+            this.instalando = false;
+            this.ponteAtiva = null;
+            this.mostrar('Não deu para instalar', String(r.errorText || 'Erro desconhecido') +
+              '\n\nConfira se o Homebrew Channel está instalado e com root.', [{ rotulo: 'OK' }]);
+            return;
+          }
+          if (r.finished) {
+            texto('Instalado! O Saimo TV vai fechar e abrir de novo sozinho em alguns segundos.');
+            return;
+          }
+          if (r.statusText) {
+            const pct = typeof r.progress === 'number' ? ' ' + Math.round(r.progress) + '%' : '';
+            const traducao: { [k: string]: string } = {
+              'Downloading…': 'Baixando…', 'Verifying…': 'Conferindo o arquivo…', 'Installing…': 'Instalando…',
+            };
+            texto((traducao[r.statusText] || r.statusText) + pct);
+          }
+        },
+      );
+    } catch (e: any) {
+      desarmarReabertura();
+      this.instalando = false;
+      this.mostrar('Não deu para instalar', String(e && e.message || e), [{ rotulo: 'OK' }]);
+    }
+  }
+
+  private static mostrar(
+    titulo: string,
+    mensagem: string,
+    botoes: { rotulo: string; primario?: boolean; acao?: () => void }[],
+  ) {
+    if (!this.el) {
+      this.el = document.createElement('div');
+      this.el.className = 'tv-modal-overlay';
+      this.el.style.zIndex = '9000';
+      (document.getElementById('app') || document.body).appendChild(this.el);
+      window.addEventListener('keydown', (e) => {
+        if (!this.el || this.el.style.display === 'none' || !Platform.isBackKey(e.keyCode)) return;
+        e.preventDefault();
+        e.stopImmediatePropagation();
+        if (!this.instalando) this.fechar();
+      }, true);
+    }
+    const devolver = SpatialNav.getCurrent();
+    this.el.innerHTML =
+      '<div class="tv-modal-content">' +
+      '<div class="tv-modal-title"></div>' +
+      '<p class="saimo-atu-texto" style="font-size:24px;line-height:1.45;white-space:pre-line;margin:0 0 28px;"></p>' +
+      '<div class="saimo-atu-botoes" style="display:flex;"></div>' +
+      '</div>';
+    this.el.querySelector('.tv-modal-title')!.textContent = titulo;
+    this.el.querySelector('.saimo-atu-texto')!.textContent = mensagem;
+    const area = this.el.querySelector('.saimo-atu-botoes') as HTMLElement;
+    let primeiro: HTMLElement | null = null;
+    botoes.forEach((b, i) => {
+      const btn = document.createElement('div');
+      btn.className = 'tv-btn nav-focusable' + (b.primario ? ' primary' : '');
+      btn.setAttribute('data-nav', 'true');
+      if (i > 0) btn.style.marginLeft = '16px';
+      btn.textContent = b.rotulo;
+      btn.addEventListener('click', () => {
+        if (!b.acao || b.rotulo !== 'Instalar agora') this.fechar(devolver);
+        if (b.acao) b.acao();
+      });
+      area.appendChild(btn);
+      if (!primeiro) primeiro = btn;
+    });
+    this.el.style.display = 'flex';
+    SpatialNav.setTrap(this.el);
+    if (primeiro) SpatialNav.focus(primeiro);
+  }
+
+  private static fechar(devolver?: HTMLElement | null) {
+    if (!this.el) return;
+    this.el.style.display = 'none';
+    SpatialNav.setTrap(null);
+    if (devolver && document.body.contains(devolver)) SpatialNav.focus(devolver);
+  }
+}
