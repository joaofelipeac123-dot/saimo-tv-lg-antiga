   } catch (e) {
     semGap = true;
   }
-  if (semGap) raiz.className += (raiz.className ? ' ' : '') + 'sem-gap';
+  if (semGap) {
+    raiz.className += (raiz.className ? ' ' : '') + 'sem-gap';
+    vigiarGapInline();
+  }
   return !semGap;
 }
 
+/**
+ * HTML montado pelo código com `style="display:flex; gap:12px"`: o atributo guarda o texto
+ * mesmo quando a TV não entende `gap`, então dá para ler e aplicar o fallback.
+ */
+function vigiarGapInline() {
+  const tratar = (raizBusca: Element | Document) => {
+    const lista = raizBusca.querySelectorAll('[style*="gap"]');
+    const todos: Element[] = [];
+    if ((raizBusca as Element).getAttribute && ((raizBusca as Element).getAttribute('style') || '').indexOf('gap') >= 0) {
+      todos.push(raizBusca as Element);
+    }
+    for (let i = 0; i < lista.length; i++) todos.push(lista[i]);
+    for (let i = 0; i < todos.length; i++) {
+      const el = todos[i] as HTMLElement;
+      if ((el as any).__gapFb) continue;
+      const estilo = el.getAttribute('style') || '';
+      const m = /(?:^|;)\s*gap\s*:\s*([^;]+)/i.exec(estilo);
+      if (!m) continue;
+      (el as any).__gapFb = true;
+      const valor = m[1].trim().split(/\s+/)[0];
+      const direcao = /flex-wrap\s*:\s*wrap/i.test(estilo)
+        ? 'wrap'
+        : /flex-direction\s*:\s*column/i.test(estilo) ? 'column' : 'row';
+      aplicarGap(el, valor, direcao);
+    }
+  };
+  const iniciar = () => {
+    tratar(document);
+    if (typeof MutationObserver === 'undefined') return;
+    new MutationObserver((mudancas) => {
+      for (let i = 0; i < mudancas.length; i++) {
+        const nos = mudancas[i].addedNodes;
+        for (let j = 0; j < nos.length; j++) {
+          if (nos[j].nodeType === 1) tratar(nos[j] as Element);
+        }
+      }
+    }).observe(document.documentElement, { childList: true, subtree: true });
+  };
+  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', iniciar);
+  else iniciar();
+}
+
 const regrasCriadas: { [classe: string]: boolean } = {};
 let folha: HTMLStyleElement | null = null;
 
 /** Define o gap de um contêiner flex criado pelo código, com fallback para TV antiga. */
-export function aplicarGap(el: HTMLElement, valor: string, direcao: 'row' | 'column' = 'row') {
+export function aplicarGap(el: HTMLElement, valor: string, direcao: 'row' | 'column' | 'wrap' = 'row') {
   (el.style as any).gap = valor;
   if (detectarGap()) return;
   const classe = 'gapfb-' + direcao + '-' + valor.replace(/[^a-z0-9]/gi, '_');
@@ -46,8 +91,10 @@ export function aplicarGap(el: HTMLElement, valor: string, direcao: 'row' | 'col
       folha = document.createElement('style');
       document.head.appendChild(folha);
     }
-    const lado = direcao === 'column' ? 'margin-top' : 'margin-left';
-    folha.appendChild(document.createTextNode('.' + classe + '>*+*{' + lado + ':' + valor + '}'));
+    const regra = direcao === 'wrap'
+      ? '.' + classe + '>*{margin-right:' + valor + ';margin-bottom:' + valor + '}'
+      : '.' + classe + '>*+*{' + (direcao === 'column' ? 'margin-top' : 'margin-left') + ':' + valor + '}';
+    folha.appendChild(document.createTextNode(regra));
   }
   el.classList.add(classe);
 }
