diff --git a/tv-native/vite.config.ts b/tv-native/vite.config.ts
index 4f0eb00d8857af4a1d780e8b960eadf9af677c3f..3a317e87d41365e25ab102df5768c0fc612215b2 100644
--- a/tv-native/vite.config.ts
+++ b/tv-native/vite.config.ts
@@ -47,17 +47,123 @@ function temaCss() {
 }
 temaCss.postcss = true
 
+/**
+ * Fallback de `gap` em flexbox para TVs com Chromium < 84 (webOS 3/4/5, Tizen antigo).
+ * Para cada regra com `gap`, gera `html.sem-gap <seletor> > * + * { margin-… }`.
+ * A classe `sem-gap` só é posta no <html> quando a TV não suporta gap (src/core/Gap.ts),
+ * então nas TVs novas nada muda.
+ */
+function gapFallback() {
+  const sides = (v: string) => {
+    const p = v.trim().split(/\s+/);
+    return { linha: p[0], coluna: p[1] || p[0] };
+  };
+  return {
+    postcssPlugin: 'saimo-gap-fallback',
+    Once(root: any, { Rule }: any) {
+      // Direção e quebra de linha por seletor, considerando todas as regras do arquivo.
+      const dir: Record<string, string> = {};
+      const wrap: Record<string, boolean> = {};
+      root.walkRules((r: any) => {
+        r.walkDecls((d: any) => {
+          for (const s of r.selectors) {
+            if (d.prop === 'flex-direction') dir[s] = d.value;
+            if (d.prop === 'flex-wrap') wrap[s] = d.value !== 'nowrap';
+            if (d.prop === 'flex-flow') {
+              if (/column/.test(d.value)) dir[s] = 'column';
+              if (/\bwrap/.test(d.value)) wrap[s] = true;
+            }
+          }
+        });
+      });
+      root.walkRules((r: any) => {
+        if (r.selector.startsWith('html.sem-gap')) return;
+        let linha = '', coluna = '';
+        r.each((d: any) => {
+          if (d.type !== 'decl') return;
+          if (d.prop === 'gap') ({ linha, coluna } = sides(d.value));
+          if (d.prop === 'row-gap') linha = d.value.trim();
+          if (d.prop === 'column-gap') coluna = d.value.trim();
+        });
+        if (!linha && !coluna) return;
+        const novas: any[] = [];
+        for (const s of r.selectors) {
+          if (s.includes('::') || /:(before|after)\b/.test(s)) continue;
+          const coluna_ = /column/.test(dir[s] || '');
+          const reverso = /reverse/.test(dir[s] || '');
+          if (wrap[s]) {
+            const decl = [] as { prop: string; value: string }[];
+            if (coluna && coluna !== '0') decl.push({ prop: "margin-right", value: coluna });
+            if (linha && linha !== '0') decl.push({ prop: "margin-bottom", value: linha });
+            if (decl.length) novas.push(new Rule({ selector: `html.sem-gap ${s}>*`, nodes: [] }).append(...decl));
+          } else {
+            const valor = coluna_ ? linha : coluna;
+            if (!valor || valor === '0') continue;
+            const lado = coluna_ ? (reverso ? 'margin-bottom' : 'margin-top') : (reverso ? 'margin-right' : 'margin-left');
+            novas.push(new Rule({ selector: `html.sem-gap ${s}>*+*`, nodes: [] }).append({ prop: lado, value: valor }));
+          }
+        }
+        let ref = r;
+        for (const n of novas) { ref.after(n); ref = n; }
+      });
+    },
+  };
+}
+
+/**
+ * Reserva para `var()` em TV antiga (Chromium < 49 não tem variáveis de CSS): antes de cada
+ * declaração com `var(--x, reserva)` põe a mesma declaração com a reserva já resolvida.
+ * A TV antiga fica com a cor padrão (ignora a linha com var); as novas usam a do tema.
+ */
+function varReserva() {
+  const resolver = (v: string): string | null => {
+    for (let guarda = 0; guarda < 50; guarda++) {
+      const i = v.lastIndexOf('var(');
+      if (i < 0) return v;
+      let prof = 0, virgula = -1, fim = -1;
+      for (let j = i + 4; j < v.length; j++) {
+        const c = v[j];
+        if (c === '(') prof++;
+        else if (c === ')') { if (prof === 0) { fim = j; break; } prof--; }
+        else if (c === ',' && prof === 0 && virgula < 0) virgula = j;
+      }
+      if (fim < 0 || virgula < 0) return null; // sem reserva: não há o que pôr
+      v = v.slice(0, i) + v.slice(virgula + 1, fim).trim() + v.slice(fim + 1);
+    }
+    return null;
+  };
+  return {
+    postcssPlugin: 'saimo-var-reserva',
+    OnceExit(root: any) {
+      root.walkDecls((d: any) => {
+        if (d.prop.startsWith('--') || d.value.indexOf('var(') < 0) return;
+        const v = resolver(d.value);
+        if (!v || v === d.value) return;
+        const ant = d.prev();
+        if (ant && ant.type === 'decl' && ant.prop === d.prop && ant.value === v) return;
+        d.cloneBefore({ value: v });
+      });
+    },
+  };
+}
+
 export default defineConfig({
-  css: { postcss: { plugins: [temaCss()] } },
   root: '.',
   base: './',
   define: {
     __VERSAO_APP__: JSON.stringify(versao)
   },
