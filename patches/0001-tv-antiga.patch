diff --git a/tv-native/src/core/Gap.ts b/tv-native/src/core/Gap.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2646d6207850f09992a0dc89254f13d5b763afa3
--- /dev/null
+++ b/tv-native/src/core/Gap.ts
@@ -0,0 +1,53 @@
+/**
+ * `gap` em flexbox só existe a partir do Chromium 84 (TVs LG/Samsung de 2021+).
+ * Em TV antiga (webOS 3/4/5, Tizen até 5.5) a propriedade é ignorada e os itens ficam colados.
+ *
+ * - CSS das folhas de estilo: o plugin PostCSS em vite.config.ts gera regras de margem sob
+ *   `html.sem-gap`, que só valem quando este arquivo detecta a falta de suporte.
+ * - Gap definido pelo código (`el.style.gap`): use `aplicarGap()` em vez de `style.gap`.
+ */
+
+let semGap: boolean | null = null;
+
+export function detectarGap(): boolean {
+  if (semGap !== null) return !semGap;
+  const raiz = document.documentElement;
+  try {
+    const teste = document.createElement('div');
+    teste.style.display = 'flex';
+    teste.style.flexDirection = 'column';
+    (teste.style as any).rowGap = '1px';
+    (teste.style as any).gap = '1px';
+    teste.style.position = 'absolute';
+    teste.style.visibility = 'hidden';
+    teste.appendChild(document.createElement('div'));
+    teste.appendChild(document.createElement('div'));
+    raiz.appendChild(teste);
+    semGap = teste.scrollHeight !== 1;
+    raiz.removeChild(teste);
+  } catch (e) {
+    semGap = true;
+  }
+  if (semGap) raiz.className += (raiz.className ? ' ' : '') + 'sem-gap';
+  return !semGap;
+}
+
+const regrasCriadas: { [classe: string]: boolean } = {};
+let folha: HTMLStyleElement | null = null;
+
+/** Define o gap de um contêiner flex criado pelo código, com fallback para TV antiga. */
+export function aplicarGap(el: HTMLElement, valor: string, direcao: 'row' | 'column' = 'row') {
+  (el.style as any).gap = valor;
+  if (detectarGap()) return;
+  const classe = 'gapfb-' + direcao + '-' + valor.replace(/[^a-z0-9]/gi, '_');
+  if (!regrasCriadas[classe]) {
+    regrasCriadas[classe] = true;
+    if (!folha) {
+      folha = document.createElement('style');
+      document.head.appendChild(folha);
+    }
+    const lado = direcao === 'column' ? 'margin-top' : 'margin-left';
+    folha.appendChild(document.createTextNode('.' + classe + '>*+*{' + lado + ':' + valor + '}'));
+  }
+  el.classList.add(classe);
+}
