 2 files changed, 107 insertions(+), 2 deletions(-)
 create mode 100644 tv-native/src/core/polyfillsFaltantes.ts

diff --git a/tv-native/src/core/polyfills.ts b/tv-native/src/core/polyfills.ts
index 001ddc1f479488852fc14d029f28ecdbbce655b0..b957f3433a58e8142b7f10ac8e640d8643687388 100644
--- a/tv-native/src/core/polyfills.ts
